generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EDUCATOR
  CLIENT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_CANCELLED_BY_CLIENT
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String
  phone     String?
  role      Role
  address   String?
  city      String?
  zipCode   String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  educatorProfile EducatorProfile?
  dogs            Dog[]
  clientBookings  Booking[]        @relation("ClientBookings")
  notifications   Notification[]
}

model EducatorProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  bio             String? @db.Text
  address         String
  city            String
  zipCode         String
  lat             Float
  lng             Float
  siret           String? @unique
  stripeAccountId String?
  bannerUrl       String?
  profilePhotoUrl String?
  galleryUrls     String[] @default([])
  showLocationMap Boolean  @default(true)

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  services         Service[]
  educatorBookings Booking[]      @relation("EducatorBookings")
  availabilities   Availability[]
  memos            Memo[]
}

model Dog {
  id              String  @id @default(cuid())
  userId          String
  name            String
  breed           String?
  age             Int?
  weight          Float?
  behavioralNotes String? @db.Text
  medicalNotes    String? @db.Text
  photoUrl        String?

  owner    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]
}

model Service {
  id                String  @id @default(cuid())
  educatorProfileId String
  title             String
  description       String? @db.Text
  durationMinutes   Int
  price             Int
  isActive          Boolean @default(true)

  educatorProfile EducatorProfile @relation(fields: [educatorProfileId], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@index([educatorProfileId, isActive])
}

model Booking {
  id                String        @id @default(cuid())
  userId            String
  dogId             String
  serviceId         String
  educatorProfileId String
  dateTime          DateTime
  status            BookingStatus @default(PENDING)
  postSessionReport String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  client    User            @relation("ClientBookings", fields: [userId], references: [id])
  dog       Dog             @relation(fields: [dogId], references: [id])
  service   Service         @relation(fields: [serviceId], references: [id])
  educator  EducatorProfile @relation("EducatorBookings", fields: [educatorProfileId], references: [id])
  notifications Notification[]
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  bookingId String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Availability {
  id                String @id @default(cuid())
  educatorProfileId String
  dayOfWeek         Int
  startTime         String
  endTime           String
  isActive          Boolean @default(true)

  educatorProfile EducatorProfile @relation(fields: [educatorProfileId], references: [id], onDelete: Cascade)

  @@index([educatorProfileId, dayOfWeek])
}

model Memo {
  id                String    @id @default(cuid())
  educatorProfileId String
  content           String    @db.Text
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  educatorProfile EducatorProfile @relation(fields: [educatorProfileId], references: [id], onDelete: Cascade)

  @@index([educatorProfileId, archivedAt, createdAt])
}
