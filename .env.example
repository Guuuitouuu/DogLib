# Database (Supabase PostgreSQL — encode special chars in password, e.g. ? → %3F)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?uselibpqcompat=true&sslmode=require"

# Optional: pool size per serverless instance (default 3 in production)
# DB_POOL_MAX=3

# Public site URL (SEO, sitemap, metadata) — set to your Vercel domain in prod
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk (https://dashboard.clerk.com — create an application)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Redirects (optional — also set on SignIn/SignUp components)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/auth/continue
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/continue

# Clerk webhook (Dashboard → Webhooks → endpoint /api/webhooks/clerk)
CLERK_WEBHOOK_SECRET=

# Stripe Connect (à brancher) — ne pas exposer côté client
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
